<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BreakoutExam.MainPage"
             Title="Breakout"
             BackgroundColor="#1E1E2E">

    <!--
        The layout is given to you: you don't need to edit this file.

        Setup: create a new project with  dotnet new maui -n BreakoutExam  and replace
        its MainPage.xaml and MainPage.xaml.cs with these two files. All styles live in
        this file, so it doesn't depend on anything else in the project.
        (Visual Studio: .NET MAUI App template, .NET 10, with "Include sample content" UNticked.)

        Every element you need from C# has an x:Name, so it is available as a field
        in MainPage.xaml.cs (ScoreLabel, HighScoreLabel, TimeLabel, GameArea, Paddle,
        Ball, GameOverLabel, LeftButton, StartButton, RightButton).

        Styles are in ContentPage.Resources below. BrickStyle isn't used here; you
        look it up from C# in Part C:  (Style)Resources["BrickStyle"]

        NOTE: no events are connected in this file. Nothing happens when you press a
        button until you wire it up in C# (Part B, in the MainPage constructor).
    -->

    <ContentPage.Resources>
        <Style x:Key="BrickStyle" TargetType="BoxView">
            <Setter Property="Color" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>

        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#89B4FA" />
            <Setter Property="TextColor" Value="#1E1E2E" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="WidthRequest" Value="90" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="10"
          RowSpacing="10">

        <!-- Header: score, high score, time left -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <Label x:Name="ScoreLabel"
                   Grid.Column="0"
                   Text="Score: 0"
                   Style="{StaticResource HeaderLabelStyle}" />
            <Label x:Name="HighScoreLabel"
                   Grid.Column="1"
                   Text="Best: 0"
                   Style="{StaticResource HeaderLabelStyle}" />
            <Label x:Name="TimeLabel"
                   Grid.Column="2"
                   Text="Time: 60"
                   Style="{StaticResource HeaderLabelStyle}" />
        </Grid>

        <!-- Play area. (0,0) is the top-left corner; bricks are added here from C#. -->
        <AbsoluteLayout x:Name="GameArea"
                        Grid.Row="1"
                        BackgroundColor="Black"
                        IsClippedToBounds="True">

            <BoxView x:Name="Paddle"
                     Color="White"
                     CornerRadius="4"
                     AbsoluteLayout.LayoutBounds="0,0,100,15" />

            <BoxView x:Name="Ball"
                     Color="Yellow"
                     CornerRadius="8"
                     AbsoluteLayout.LayoutBounds="0,0,16,16" />

            <Label x:Name="GameOverLabel"
                   IsVisible="False"
                   Opacity="0"
                   ZIndex="10"
                   TextColor="White"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize" />
        </AbsoluteLayout>

        <!-- Controls -->
        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="Center"
                               Spacing="20">
            <Button x:Name="LeftButton"
                    Text="◀"
                    Style="{StaticResource ControlButtonStyle}" />
            <Button x:Name="StartButton"
                    Text="Start"
                    WidthRequest="150"
                    Style="{StaticResource ControlButtonStyle}" />
            <Button x:Name="RightButton"
                    Text="▶"
                    Style="{StaticResource ControlButtonStyle}" />
        </HorizontalStackLayout>
    </Grid>

</ContentPage>
